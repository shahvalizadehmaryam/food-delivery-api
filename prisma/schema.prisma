
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        Int       @id @default(autoincrement())
  phone     String    @unique
  name      String?
  lastname  String?   // last / family name from registration
  state     String?   // US state code, e.g. "CA"
  city      String?
  address   String?
  dob       DateTime? @db.Date // date of birth (YYYY-MM-DD)
  role      Role      @default(USER)
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tokens    Token[]
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String   // store hashed, not plain text
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone])
}

model Token {
  id          Int       @id @default(autoincrement())
  token       String
  type        TokenType
  expires     DateTime
  blacklisted Boolean
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

model MenuSection {
  id        String     @id          // "burgers", "fries"
  title     String                  // "Burgers"
  sortOrder Int        @default(0)  // optional: control section order
  items     MenuItem[]
}

model MenuItem {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  image       String
  sectionId   String
  section     MenuSection    @relation(fields: [sectionId], references: [id])
  sizes       MenuItemSize[]
  flashDeals  FlashDeal[]
}

/// Time-limited discount for a menu item (optionally one size only).
/// Active when: isActive && startsAt <= now < endsAt
model FlashDeal {
  id            Int      @id @default(autoincrement())
  menuItemId    Int
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sizeId        String?  // null = apply to all sizes; e.g. "medium" = one size only
  discountType  String   // "percentage" | "fixed"
  discountValue Decimal  @db.Decimal(10, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([menuItemId])
}

model MenuItemSize {
  id            String                 // "small", "medium", "large"
  label         String                 // "Small"
  price         Decimal  @db.Decimal(10, 2)
  discountType  String?                // "percentage" | "fixed"
  discountValue Decimal? @db.Decimal(10, 2)
  itemId        Int
  item          MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, id])
}
