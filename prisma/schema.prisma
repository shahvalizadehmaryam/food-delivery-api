
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        Int       @id @default(autoincrement())
  phone     String    @unique
  name      String?
  lastname  String?   // last / family name from registration
  state     String?   // US state code, e.g. "CA"
  city      String?
  address   String?
  dob       DateTime? @db.Date // date of birth (YYYY-MM-DD)
  role      Role      @default(USER)
  isBlocked Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tokens    Token[]
  baskets   Basket[]
  orders    Order[]
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String   // store hashed, not plain text
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone])
}

model Token {
  id          Int       @id @default(autoincrement())
  token       String
  type        TokenType
  expires     DateTime
  blacklisted Boolean
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

model MenuSection {
  id        String     @id          // "burgers", "fries"
  title     String                  // "Burgers"
  sortOrder Int        @default(0)  // optional: control section order
  items     MenuItem[]
}

model MenuItem {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  image       String
  sectionId   String
  section     MenuSection    @relation(fields: [sectionId], references: [id])
  sizes       MenuItemSize[]
  flashDeals  FlashDeal[]
  basketItems BasketItem[]
}

/// Time-limited discount for a menu item (optionally one size only).
/// Active when: isActive && startsAt <= now < endsAt
model FlashDeal {
  id            Int      @id @default(autoincrement())
  menuItemId    Int
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sizeId        String?  // null = apply to all sizes; e.g. "medium" = one size only
  discountType  String   // "percentage" | "fixed"
  discountValue Decimal  @db.Decimal(10, 2)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
  @@index([menuItemId])
}

model MenuItemSize {
  id            String                 // "small", "medium", "large"
  label         String                 // "Small"
  price         Decimal  @db.Decimal(10, 2)
  discountType  String?                // "percentage" | "fixed"
  discountValue Decimal? @db.Decimal(10, 2)
  itemId        Int
  item          MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, id])
}

/// Guest basket: userId = null. Logged-in basket: userId set (one active basket per user).
model Basket {
  id        String       @id
  userId    Int?         @unique
  user      User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     BasketItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
model BasketItem {
  id            Int      @id @default(autoincrement())
  basketId      String
  basket        Basket   @relation(fields: [basketId], references: [id], onDelete: Cascade)
  productId     Int
  menuItem      MenuItem @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizeId        String
  sizeLabel     String
  title         String
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal  @db.Decimal(10, 2)
  discountType  String?
  discountValue Decimal?
  quantity      Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([basketId, productId, sizeId])
  @@index([basketId])
}

enum OrderStatus{
  PLACED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int
  user            User          @relation(fields: [userId], references: [id])
  status          OrderStatus   @default(PLACED)
  items           OrderItem[]
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryAddress String
  note            String?
  isValidOrder    Boolean       @default(true)
  placedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cancelledAt     DateTime?
  @@index([userId, placedAt])
  @@index([status])
}

model OrderItem {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  title         String
  sizeId        String
  sizeLabel     String
  price         Decimal  @db.Decimal(10, 2)
  originalPrice Decimal  @db.Decimal(10, 2)
  quantity      Int
  createdAt     DateTime @default(now())
}