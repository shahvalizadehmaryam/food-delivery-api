
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?
  role      Role     @default(USER)
  isBlocked Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tokens    Token[]
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String   // store hashed, not plain text
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone])
}

model Token {
  id          Int       @id @default(autoincrement())
  token       String
  type        TokenType
  expires     DateTime
  blacklisted Boolean
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

model MenuSection {
  id        String     @id          // "burgers", "fries"
  title     String                  // "Burgers"
  sortOrder Int        @default(0)  // optional: control section order
  items     MenuItem[]
}

model MenuItem {
  id          Int            @id @default(autoincrement())
  title       String
  description String
  image       String
  sectionId   String
  section     MenuSection    @relation(fields: [sectionId], references: [id])
  sizes       MenuItemSize[]
}

model MenuItemSize {
  id            String                 // "small", "medium", "large"
  label         String                 // "Small"
  price         Decimal  @db.Decimal(10, 2)
  discountType  String?                // "percentage" | "fixed"
  discountValue Decimal? @db.Decimal(10, 2)
  itemId        Int
  item          MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, id])
}
